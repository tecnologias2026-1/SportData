# ══════════════════════════════════════════
#  SportData — Variables de entorno
#  Copia este archivo a .env y complétalo
#  NUNCA subas .env a GitHub
# ══════════════════════════════════════════

# Puerto (Render lo inyecta automáticamente)
PORT=3000

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_seguro
JWT_EXPIRES_IN=7d

# CORS — URL exacta del frontend en producción (sin slash al final)
# Ejemplo: https://mi-sportdata.netlify.app
# En desarrollo dejar como * para permitir cualquier origen
ALLOWED_ORIGIN=*

# Ruta del archivo SQLite (opcional, por defecto: backend/database/sportdata.db)
# DB_FILE=./database/sportdata.db
