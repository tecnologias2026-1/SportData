# ============================================
# SportData — Variables de entorno
# ============================================
# Copia este archivo como .env y ajusta los valores
# NUNCA subas el .env real al repositorio

# Puerto del servidor (Render u otros hosts lo inyectan automáticamente)
PORT=3000

# Clave secreta para firmar JWT — cámbiala en producción
JWT_SECRET=sportdata_jwt_secret_2024_cambiar_en_produccion

# Expiración del token
JWT_EXPIRES_IN=7d
