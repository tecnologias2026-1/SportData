# ============================================
# SportData — Variables de entorno
# ============================================
# Copia este archivo como .env y ajusta los valores
# NUNCA subas el .env real al repositorio

# Puerto del servidor (Render lo inyecta automáticamente)
PORT=3000

# Clave secreta para firmar JWT — cámbiala en producción
JWT_SECRET=sportdata_jwt_secret_CAMBIA_ESTO

# Expiración del token
JWT_EXPIRES_IN=7d

# URL del frontend en Netlify (sin slash al final)
# Ejemplo: https://mi-sportdata.netlify.app
FRONTEND_URL=https://TU-SITIO.netlify.app
